{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Boosters NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2021",
    "isolatedModules": false
  }
}
