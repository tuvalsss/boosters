# =============================================================================
# Boosters — SINGLE environment file (DEVNET / SANDBOX ONLY)
#
# This is the ONE place env lives. The root `.env` feeds every app (web, api,
# worker) — `bootstrapEnv()` loads it and Next.js reads it via next.config.
# Copy to `.env` and fill in. NEVER commit a real `.env`.
#
# All defaults are devnet/sandbox. Real mainnet/payments are gated by flags and
# may only be enabled after a smart-contract audit (see README §Guardrails).
# =============================================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Network / mode guardrails ----
# Hard guardrail: the platform refuses to run money paths unless these match.
SOLANA_CLUSTER=devnet                 # devnet | testnet | mainnet-beta (mainnet gated)
PAYMENTS_MODE=sandbox                 # sandbox | live (live gated, post-audit)
ENABLE_MAINNET=false                  # must stay false until audited
ENABLE_REAL_PAYMENTS=false            # must stay false until audited
ENABLE_REAL_KYC=false                 # feature flag for Veriff/Sumsub

# ---- Database ----
DATABASE_URL=postgresql://boosters:boosters@localhost:5432/boosters?schema=public

# ---- Redis (queues, rate limits, locks) ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000
# Publicly reachable API base URL — token metadata URIs point here.
PUBLIC_API_URL=http://localhost:4000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ---- Solana / RPC ----
SOLANA_RPC_URL=https://api.devnet.solana.com
# Helius DAS API (cNFT indexing/reads) — devnet key
HELIUS_API_KEY=
HELIUS_RPC_URL=

# ---- Metaplex Bubblegum (cNFT mint) ----
# Devnet mint authority: base58 secret key OR a JSON byte array.
# Create a Merkle tree once with `node scripts/create-merkle-tree.mjs` and paste
# its address below. Required to vault/mint; vaulting fails clearly if unset.
MINT_AUTHORITY_SECRET=
MERKLE_TREE_ADDRESS=

# ---- Auth: Privy (real) ----
# Create an app at https://dashboard.privy.io and paste the IDs/secret here.
# Server verifies access tokens; web uses the public app id to render login.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=                # optional ES256 public key (PEM) for offline verify
NEXT_PUBLIC_PRIVY_APP_ID=

# ---- Access control / RBAC ----
# Comma-separated emails auto-granted ADMIN on first login (bootstraps the
# admin panel). e.g. ADMIN_BOOTSTRAP_EMAILS=you@example.com
ADMIN_BOOTSTRAP_EMAILS=

# ---- Randomness / VRF (provably-fair) ----
VRF_PROVIDER=orao                     # orao | switchboard
ORAO_VRF_PROGRAM=

# ---- Payments: Coinflow (sandbox) ----
COINFLOW_MERCHANT_ID=
COINFLOW_API_KEY=
COINFLOW_ENV=sandbox

# ---- USDC (settlement) ----
# Devnet USDC mint by default.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---- KYC ----
# manual = real ops review via the admin panel (devnet default, no auto-approve).
# veriff/sumsub are real providers, gated behind ENABLE_REAL_KYC (Phase 10).
KYC_PROVIDER=manual                   # manual | veriff | sumsub
VERIFF_API_KEY=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# ---- Media storage (S3 / Cloudflare R2) ----
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=boosters-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Token metadata (Arweave / IPFS) ----
METADATA_STORAGE=irys                 # irys (arweave) | ipfs
IRYS_NODE=https://devnet.irys.xyz

# ---- Treasury / buyback guardrails ----
# Buyback never spends below this USDC float floor (hard guard + test).
BUYBACK_FLOAT_FLOOR_USDC=1000
BUYBACK_DEFAULT_PERCENT_BPS=8750      # 87.5% of FMV
MARKETPLACE_FEE_BPS=200               # 2% marketplace fee

# ---- Anti-fraud limits ----
LISTING_FMV_DEVIATION_BPS=2500        # auto-hold listings >25% off FMV
RATE_LIMIT_LISTINGS_PER_DAY=25
RATE_LIMIT_SUBMISSIONS_PER_DAY=10
